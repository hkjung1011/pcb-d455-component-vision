%% 공개 도식: 사진·실제 데이터·실험 수치·개인정보 없음
flowchart TB
    subgraph TRAIN["학습 단계 — 제안 명세 / PLANNED · NOT_IMPLEMENTED · NOT_RUN"]
        X["train PCB 영상 + IC 정답 박스 + ignore 영역<br/>완전 라벨 여부 확인"]
        G["두 경로에 같은 기하 변환<br/>640×640 clean canvas · 정답 좌표 공유"]
        C["clean 입력 x_c<br/>추가 해상도 저하·잡음 없음"]
        N["noisy 입력 x_n<br/>축소 → 640 복원 → Gaussian 잡음 → clip"]
        T["고정 Teacher f_θ₀<br/>clean 기준 checkpoint · eval · no_grad<br/>Student와 별도 가중치 / EMA 없음"]
        subgraph STUDENT["공유 Student f_θ — 같은 가중치로 두 번 순전파"]
            P["가중치 θ 하나<br/>θ₀에서 초기화"]
            SC["Student clean 경로<br/>logits · 박스 · P3 특징"]
            SN["Student noisy 경로<br/>logits · 박스 · P3 특징"]
            P -.-> SC
            P -.-> SN
        end
        A["L_anchor<br/>Teacher → Student clean<br/>동일 위치 sigmoid soft-target BCE<br/>T=1 · Teacher score ≥ 0.5"]
        R["GT 좌표 기준 ROIAlign<br/>P3 · 7×7 → 공간 평균<br/>clean 특징만 stopgrad"]
        K["L_cons<br/>clean/noisy ROI cosine distance<br/>eps=1e−6"]
        D["기본 검출 손실<br/>L_det_clean + L_det_noisy<br/>공유 IC 정답 박스 사용"]
        H["L_HN<br/>완전 라벨 train만 · ignore 제외<br/>noisy score ≥ 0.25 · 모든 GT IoU ≤ 0.1<br/>pre-NMS top-100 · 배경 BCE"]
        L["합손실<br/>L_total = 0.5×(L_det_clean + L_det_noisy)<br/>+ λ_anchor L_anchor + λ_cons L_cons + λ_HN L_HN<br/>λ 모두 1.0 — 초안·미조정"]
        U["Student θ만 한 번 갱신<br/>Teacher θ₀는 고정"]
        X --> G
        G --> C
        G --> N
        C --> T
        C --> SC
        N --> SN
        T --> A
        SC --> A
        SC --> R
        SN --> R
        G -.->|"같은 GT 좌표"| R
        R --> K
        SC --> D
        SN --> D
        SN --> H
        A --> L
        K --> L
        D --> L
        H --> L
        L --> U
    end
    subgraph INFER["추론 단계 — 학습 구현·실행 후 사용할 구성"]
        I["추론용 PCB 영상"]
        M["학습한 Student 하나<br/>Teacher·학습 손실 제외"]
        O["IC 위치 박스 + 검출 점수"]
        I --> M --> O
    end
    U -.->|"학습이 완료되면 선택한 checkpoint"| M
